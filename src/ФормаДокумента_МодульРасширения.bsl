////////////////////////////////////////////////////////////////////////////////
// Расширение: Расш_Шувалов_ЗПЦО
// Объект: Документ.ЗаказПоставщику.Форма.ФормаДокумента
// Назначение: добавить в табличную часть "Товары" колонки "Остаток" с
// доступным остатком и "Закупочная цена".
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиРасширения

&НаСервере
&После("ПриСозданииНаСервере")
Процедура Расш_Шувалов_ЗПЦО_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	Расш_Шувалов_ЗПЦО_ДобавитьКолонкиТоваров();
	Расш_Шувалов_ЗПЦО_ЗаполнитьПоказателиСтрокТоваров();

КонецПроцедуры

&НаКлиенте
&После("ПриОткрытии")
Процедура Расш_Шувалов_ЗПЦО_ПриОткрытииПосле(Отказ)

	Расш_Шувалов_ЗПЦО_ЗаполнитьПоказателиСтрокТоваров();

КонецПроцедуры

&НаКлиенте
&После("СкладПриИзменении")
Процедура Расш_Шувалов_ЗПЦО_СкладПриИзмененииПосле(Элемент)

	Расш_Шувалов_ЗПЦО_ЗаполнитьПоказателиСтрокТоваров();

КонецПроцедуры

&НаКлиенте
&После("ДатаПриИзменении")
Процедура Расш_Шувалов_ЗПЦО_ДатаПриИзмененииПосле(Элемент)

	Расш_Шувалов_ЗПЦО_ЗаполнитьПоказателиСтрокТоваров();

КонецПроцедуры

&НаКлиенте
&После("ТоварыНоменклатураПриИзменении")
Процедура Расш_Шувалов_ЗПЦО_ТоварыНоменклатураПриИзмененииПосле(Элемент)

	Расш_Шувалов_ЗПЦО_ЗаполнитьПоказателиСтрокТоваров();

КонецПроцедуры

&НаКлиенте
&После("ТоварыХарактеристикаПриИзменении")
Процедура Расш_Шувалов_ЗПЦО_ТоварыХарактеристикаПриИзмененииПосле(Элемент)

	Расш_Шувалов_ЗПЦО_ЗаполнитьПоказателиСтрокТоваров();

КонецПроцедуры

&НаКлиенте
&После("ТоварыСкладПриИзменении")
Процедура Расш_Шувалов_ЗПЦО_ТоварыСкладПриИзмененииПосле(Элемент)

	Расш_Шувалов_ЗПЦО_ЗаполнитьПоказателиСтрокТоваров();

КонецПроцедуры

&НаКлиенте
&После("ТоварыВидЦеныПоставщикаПриИзменении")
Процедура Расш_Шувалов_ЗПЦО_ТоварыВидЦеныПоставщикаПриИзмененииПосле(Элемент)

	Расш_Шувалов_ЗПЦО_ЗаполнитьПоказателиСтрокТоваров();

КонецПроцедуры

&НаСервере
&После("ОбработкаВыбораПодборНаСервере")
Процедура Расш_Шувалов_ЗПЦО_ОбработкаВыбораПодборНаСервереПосле(ВыбранноеЗначение)

	Расш_Шувалов_ЗПЦО_ЗаполнитьПоказателиСтрокТоваров();

КонецПроцедуры

#КонецОбласти

#Область ДобавлениеКолонок

&НаСервере
Процедура Расш_Шувалов_ЗПЦО_ДобавитьКолонкиТоваров()

	Расш_Шувалов_ЗПЦО_ДобавитьРеквизитыСтрокТоваров();

	ТаблицаТовары = Элементы.Найти("Товары");
	Если ТаблицаТовары = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Расш_Шувалов_ЗПЦО_ДобавитьКолонкуТоваров(
		"Товары" + Расш_Шувалов_ЗПЦО_ИмяРеквизитаОстаток(),
		Расш_Шувалов_ЗПЦО_ИмяРеквизитаОстаток(),
		НСтр("ru = 'Остаток'"),
		10);

	Расш_Шувалов_ЗПЦО_ДобавитьКолонкуТоваров(
		"Товары" + Расш_Шувалов_ЗПЦО_ИмяРеквизитаЗакупочнаяЦена(),
		Расш_Шувалов_ЗПЦО_ИмяРеквизитаЗакупочнаяЦена(),
		НСтр("ru = 'Закупочная цена'"),
		14);

КонецПроцедуры

&НаСервере
Процедура Расш_Шувалов_ЗПЦО_ДобавитьРеквизитыСтрокТоваров()

	ДобавляемыеРеквизиты = Новый Массив;

	Если Не Расш_Шувалов_ЗПЦО_ЕстьРеквизитСтрокТоваров(Расш_Шувалов_ЗПЦО_ИмяРеквизитаОстаток()) Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			Расш_Шувалов_ЗПЦО_ИмяРеквизитаОстаток(),
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)),
			"Объект.Товары",
			НСтр("ru = 'Остаток'"),
			Ложь));
	КонецЕсли;

	Если Не Расш_Шувалов_ЗПЦО_ЕстьРеквизитСтрокТоваров(Расш_Шувалов_ЗПЦО_ИмяРеквизитаЗакупочнаяЦена()) Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			Расш_Шувалов_ЗПЦО_ИмяРеквизитаЗакупочнаяЦена(),
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)),
			"Объект.Товары",
			НСтр("ru = 'Закупочная цена'"),
			Ложь));
	КонецЕсли;

	Если ДобавляемыеРеквизиты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	Исключение
		Сообщить("Расш_Шувалов_ЗПЦО: не удалось добавить реквизиты строк товаров. "
			+ "Добавьте их вручную в расширении формы и повторите проверку.");
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура Расш_Шувалов_ЗПЦО_ДобавитьКолонкуТоваров(ИмяЭлемента, ИмяРеквизита, Заголовок, Ширина)

	Если Элементы.Найти(ИмяЭлемента) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТаблицаТовары = Элементы.Найти("Товары");
	Если ТаблицаТовары = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Колонка = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ТаблицаТовары);
		Колонка.Вид = ВидПоляФормы.ПолеВвода;
		Колонка.ПутьКДанным = "Объект.Товары." + ИмяРеквизита;
		Колонка.Заголовок = Заголовок;
		Колонка.ТолькоПросмотр = Истина;
		Колонка.Видимость = Истина;

		Попытка
			Колонка.ШиринаЭлемента = Ширина;
		Исключение
			Колонка.Ширина = Ширина;
		КонецПопытки;
	Исключение
		Сообщить("Расш_Шувалов_ЗПЦО: не удалось добавить колонку " + Заголовок + ".");
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция Расш_Шувалов_ЗПЦО_ЕстьРеквизитСтрокТоваров(ИмяРеквизита)

	Попытка
		Для Каждого РеквизитФормы Из ПолучитьРеквизиты("Объект.Товары") Цикл
			Если РеквизитФормы.Имя = ИмяРеквизита Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область ЗаполнениеПоказателей

&НаСервере
Процедура Расш_Шувалов_ЗПЦО_ЗаполнитьПоказателиСтрокТоваров()

	Если Объект.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ТаблицаТоваров = Расш_Шувалов_ЗПЦО_ПодготовитьТаблицуТоваров();

	Если ТаблицаТоваров.Количество() = 0 Тогда
		Расш_Шувалов_ЗПЦО_ОчиститьПоказателиСтрокТоваров();
		Возврат;
	КонецЕсли;

	ДанныеПоказателей = Расш_Шувалов_ЗПЦО_ПолучитьПоказателиПоТоварам(
		ТаблицаТоваров,
		Расш_Шувалов_ЗПЦО_ДатаРасчета(),
		Расш_Шувалов_ЗПЦО_НайтиЗакупочныйВидЦены());

	ПоказателиПоНомерамСтрок = Новый Соответствие;
	Для Каждого СтрокаПоказателей Из ДанныеПоказателей Цикл
		ПоказателиПоНомерамСтрок.Вставить(СтрокаПоказателей.НомерСтроки, СтрокаПоказателей);
	КонецЦикла;

	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		СтрокаПоказателей = ПоказателиПоНомерамСтрок.Получить(СтрокаТовара.НомерСтроки);

		Если СтрокаПоказателей = Неопределено Тогда
			Расш_Шувалов_ЗПЦО_УстановитьПоказателиСтроки(СтрокаТовара, 0, 0);
		Иначе
			Расш_Шувалов_ЗПЦО_УстановитьПоказателиСтроки(
				СтрокаТовара,
				СтрокаПоказателей.Остаток,
				СтрокаПоказателей.ЗакупочнаяЦена);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура Расш_Шувалов_ЗПЦО_ОчиститьПоказателиСтрокТоваров()

	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		Расш_Шувалов_ЗПЦО_УстановитьПоказателиСтроки(СтрокаТовара, 0, 0);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура Расш_Шувалов_ЗПЦО_УстановитьПоказателиСтроки(СтрокаТовара, Остаток, ЗакупочнаяЦена)

	Попытка
		СтрокаТовара.Расш_Шувалов_ЗПЦО_Остаток = Остаток;
		СтрокаТовара.Расш_Шувалов_ЗПЦО_ЗакупочнаяЦена = ЗакупочнаяЦена;
	Исключение
		Возврат;
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция Расш_Шувалов_ЗПЦО_ПодготовитьТаблицуТоваров()

	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	ТаблицаТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаТоваров.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));

	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаТоваров.Добавить();
		НоваяСтрока.НомерСтроки = СтрокаТовара.НомерСтроки;
		НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
		НоваяСтрока.Характеристика = СтрокаТовара.Характеристика;
		НоваяСтрока.Склад = СтрокаТовара.Склад;

		Если Не ЗначениеЗаполнено(НоваяСтрока.Склад) Тогда
			НоваяСтрока.Склад = Объект.Склад;
		КонецЕсли;
	КонецЦикла;

	Возврат ТаблицаТоваров;

КонецФункции

&НаСервере
Функция Расш_Шувалов_ЗПЦО_ПолучитьПоказателиПоТоварам(ТаблицаТоваров, ДатаРасчета, ВидЗакупочнойЦены)

	Попытка
		Возврат Расш_Шувалов_ЗПЦО_ВыполнитьЗапросПоказателей(
			ТаблицаТоваров,
			ДатаРасчета,
			ВидЗакупочнойЦены);
	Исключение
		Сообщить("Расш_Шувалов_ЗПЦО: не удалось получить доступные остатки и закупочные цены."
			+ Символы.ПС + ОписаниеОшибки());
	КонецПопытки;

	Возврат Расш_Шувалов_ЗПЦО_ПустаяТаблицаПоказателей();

КонецФункции

&НаСервере
Функция Расш_Шувалов_ЗПЦО_ВыполнитьЗапросПоказателей(ТаблицаТоваров, ДатаРасчета, ВидЗакупочнойЦены)

	Запрос = Новый Запрос;
	Запрос.Текст = Расш_Шувалов_ЗПЦО_ТекстЗапросаПоказателей();
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	Запрос.УстановитьПараметр("СписокНоменклатуры", ТаблицаТоваров.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
	Запрос.УстановитьПараметр("ВидЗакупочнойЦены", ВидЗакупочнойЦены);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция Расш_Шувалов_ЗПЦО_ТекстЗапросаПоказателей()

	Возврат
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Склад КАК Склад
	|ПОМЕСТИТЬ ТоварыЗаказа
	|ИЗ
	|	&ТаблицаТоваров КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыЗаказа.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА СУММА(ЕСТЬNULL(Запасы.ВНаличииОстаток, 0)
	|			- ЕСТЬNULL(Запасы.ЗаблокированоВНаличииОстаток, 0)
	|			- ЕСТЬNULL(Запасы.РезервироватьНаСкладеОстаток, 0)) < 0
	|			ТОГДА 0
	|		ИНАЧЕ СУММА(ЕСТЬNULL(Запасы.ВНаличииОстаток, 0)
	|			- ЕСТЬNULL(Запасы.ЗаблокированоВНаличииОстаток, 0)
	|			- ЕСТЬNULL(Запасы.РезервироватьНаСкладеОстаток, 0))
	|	КОНЕЦ КАК Остаток
	|ПОМЕСТИТЬ ОстаткиПоСтрокам
	|ИЗ
	|	ТоварыЗаказа КАК ТоварыЗаказа
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗапасыИПотребности.Остатки(
	|			,
	|			Номенклатура В (&СписокНоменклатуры)
	|				И Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)) КАК Запасы
	|		ПО ТоварыЗаказа.Номенклатура = Запасы.Номенклатура
	|			И ТоварыЗаказа.Характеристика = Запасы.Характеристика
	|			И (ТоварыЗаказа.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|				ИЛИ ТоварыЗаказа.Склад = Запасы.Склад)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыЗаказа.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыЗаказа.НомерСтроки КАК НомерСтроки,
	|	МАКСИМУМ(Цены.Цена) КАК ЗакупочнаяЦена
	|ПОМЕСТИТЬ ЗакупочныеЦеныПоСтрокам
	|ИЗ
	|	ТоварыЗаказа КАК ТоварыЗаказа
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&ДатаРасчета,
	|			ВидЦены = &ВидЗакупочнойЦены
	|				И Номенклатура В (&СписокНоменклатуры)) КАК Цены
	|		ПО ТоварыЗаказа.Номенклатура = Цены.Номенклатура
	|			И ТоварыЗаказа.Характеристика = Цены.Характеристика
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыЗаказа.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыЗаказа.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(ОстаткиПоСтрокам.Остаток, 0) КАК Остаток,
	|	ЕСТЬNULL(ЗакупочныеЦеныПоСтрокам.ЗакупочнаяЦена, 0) КАК ЗакупочнаяЦена
	|ИЗ
	|	ТоварыЗаказа КАК ТоварыЗаказа
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиПоСтрокам КАК ОстаткиПоСтрокам
	|		ПО ТоварыЗаказа.НомерСтроки = ОстаткиПоСтрокам.НомерСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗакупочныеЦеныПоСтрокам КАК ЗакупочныеЦеныПоСтрокам
	|		ПО ТоварыЗаказа.НомерСтроки = ЗакупочныеЦеныПоСтрокам.НомерСтроки";

КонецФункции

&НаСервере
Функция Расш_Шувалов_ЗПЦО_ПустаяТаблицаПоказателей()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("НомерСтроки");
	Таблица.Колонки.Добавить("Остаток");
	Таблица.Колонки.Добавить("ЗакупочнаяЦена");

	Возврат Таблица;

КонецФункции

&НаСервере
Функция Расш_Шувалов_ЗПЦО_ДатаРасчета()

	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		Возврат КонецДня(Объект.Дата);
	КонецЕсли;

	Возврат ТекущаяДата();

КонецФункции

&НаСервере
Функция Расш_Шувалов_ЗПЦО_НайтиЗакупочныйВидЦены()

	ВариантыНаименований = Новый Массив;
	ВариантыНаименований.Добавить("Закупочная");
	ВариантыНаименований.Добавить("Закупочные");
	ВариантыНаименований.Добавить("Цена закупки");
	ВариантыНаименований.Добавить("Закупочная цена");

	Для Каждого НаименованиеВидаЦены Из ВариантыНаименований Цикл
		ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию(НаименованиеВидаЦены, Истина);
		Если ЗначениеЗаполнено(ВидЦены) Тогда
			Возврат ВидЦены;
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.ВидыЦен.ПустаяСсылка();

КонецФункции

